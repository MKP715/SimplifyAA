# Crawl cache: lets --reclassify run offline, not worth committing (~2 MB)
.cache/

# Python
__pycache__/
*.pyc

# Node, if puppeteer-core is installed here to run the browser tests
node_modules/
package.json
package-lock.json

# Screenshots written by the browser tests (tools/test_*.js, tools/audit.js)
shots/
/[0-9][0-9]-*.png

# OS noise
.DS_Store
Thumbs.db
