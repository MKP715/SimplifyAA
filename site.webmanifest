{
  "name": "SimplifyAA - A.A. Document Finder",
  "short_name": "SimplifyAA",
  "description": "An unofficial, searchable index of every PDF published on aa.org.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
